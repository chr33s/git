{
  "name": "@chr33s/git",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Git smart-HTTP protocol server, browser client & nix cli",
  "license": "MIT",
  "bin": {
    "git+": "./src/cli/bin.ts",
    "git-remote-git+id": "./src/cli/remote-id.node.ts"
  },
  "files": [
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.integration.ts",
    "!src/**/*.contract.ts",
    "!src/**/*.build.ts"
  ],
  "type": "module",
  "scripts": {
    "build:sea": "node src/cli/sea.build.ts",
    "build:ui": "node src/ui/build.ts",
    "check": "node tools/cli-docs.ts --check && oxfmt --check && oxlint",
    "dev:ui": "node src/ui/build.ts --serve",
    "docs:cli": "node tools/cli-docs.ts",
    "fix": "oxlint --fix && oxfmt --write",
    "postinstall": "patch-package && npx wrangler types -c wrangler.test.json && npm run fix",
    "prepare": "effect-tsgo patch --oxlint",
    "test": "vitest run",
    "verify:ui": "node src/ui/build.ts && node src/ui/verify.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@chr33s/base-wc": "github:chr33s/base-wc",
    "@effect/platform-node": "4.0.0-rc.111",
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "4.1.11",
    "@oxlint/plugins": "1.78.0",
    "@pierre/diffs": "1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@types/node": "26.2.0",
    "alchemy": "2.0.0-beta.72",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "patch-package": "8.0.1",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true,
    "sharp": true
  }
}
