{
  "name": "@chr33s/git",
  "version": "0.0.0",
  "private": true,
  "description": "Universal Git smart-HTTP protocol server, browser client & nix cli",
  "license": "MIT",
  "bin": {
    "chr33s-git": "./src/cli/main.ts"
  },
  "files": [
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.contract.ts"
  ],
  "type": "module",
  "scripts": {
    "check": "oxfmt --check && oxlint && tsc -b --noEmit",
    "fix": "oxlint --fix && oxfmt --write",
    "postinstall": "patch-package && npx wrangler types && npm run fix",
    "prepare": "effect-tsgo patch",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.107",
    "@effect/tsgo": "0.36.4",
    "@effect/vitest": "4.0.0-beta.107",
    "@types/node": "26.2.0",
    "alchemy": "2.0.0-beta.70",
    "esbuild": "0.28.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "patch-package": "8.0.1",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true,
    "sharp": true
  }
}
