{
  "name": "@chr33s/git",
  "version": "2.0.0-alpha.2",
  "description": "Git wire protocol for Effect: hashing, object and pack codecs, pkt-line framing, storage ports and a receive-pack client",
  "license": "MIT",
  "bin": {
    "git+": "dist/bin/cli.mjs",
    "git-remote-git+id": "dist/bin/cli.mjs"
  },
  "files": [
    "dist/lib",
    "!dist/lib/**/*.tsbuildinfo",
    "dist/bin",
    "dist/ui",
    "!dist/bin/**/*.map",
    "!dist/ui/**/*.map"
  ],
  "type": "module",
  "sideEffects": [
    "./src/**",
    "./tools/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./Authorize": {
      "types": "./dist/lib/client/Authorize.d.ts",
      "default": "./dist/lib/client/Authorize.js"
    },
    "./Errors": {
      "types": "./dist/lib/git/Error.d.ts",
      "default": "./dist/lib/git/Error.js"
    },
    "./Format": {
      "types": "./dist/lib/git/Format.d.ts",
      "default": "./dist/lib/git/Format.js"
    },
    "./Inflate": {
      "types": "./dist/lib/git/Inflate.d.ts",
      "default": "./dist/lib/git/Inflate.js"
    },
    "./Oid": {
      "types": "./dist/lib/git/Oid.d.ts",
      "default": "./dist/lib/git/Oid.js"
    },
    "./Pack": {
      "types": "./dist/lib/git/Pack.d.ts",
      "default": "./dist/lib/git/Pack.js"
    },
    "./PackFile": {
      "types": "./dist/lib/git/PackFile.d.ts",
      "default": "./dist/lib/git/PackFile.js"
    },
    "./PackIndex": {
      "types": "./dist/lib/git/PackIndex.d.ts",
      "default": "./dist/lib/git/PackIndex.js"
    },
    "./Packed": {
      "types": "./dist/lib/git/Packed.d.ts",
      "default": "./dist/lib/git/Packed.js"
    },
    "./Pkt": {
      "types": "./dist/lib/git/Pkt.d.ts",
      "default": "./dist/lib/git/Pkt.js"
    },
    "./Refspec": {
      "types": "./dist/lib/git/Refspec.d.ts",
      "default": "./dist/lib/git/Refspec.js"
    },
    "./Sha1": {
      "types": "./dist/lib/git/Sha1.d.ts",
      "default": "./dist/lib/git/Sha1.js"
    },
    "./Store": {
      "types": "./dist/lib/git/Store.d.ts",
      "default": "./dist/lib/git/Store.js"
    },
    "./Transport": {
      "types": "./dist/lib/client/Transport.d.ts",
      "default": "./dist/lib/client/Transport.js"
    },
    "./Wire": {
      "types": "./dist/lib/client/Wire.d.ts",
      "default": "./dist/lib/client/Wire.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build:bin": "node tools/generate-version.ts && npm run build:ui && node src/cli/bin.build.ts",
    "build:lib": "node -e \"fs.rmSync('dist/lib',{recursive:true,force:true})\" && tsc -p tsconfig.lib.json && node tools/annotate-pure.ts dist/lib",
    "build:sea": "npm run codegen && npm run build:ui && node src/cli/sea.build.ts",
    "build:ui": "vp build",
    "build:ui:debug": "vp build --mode development",
    "check": "vp fmt --check && vp lint && npm run docs:cli:check",
    "codegen": "node tools/generate-version.ts && wrangler types -c wrangler.test.json",
    "dev:ui": "node src/ui/dev.ts",
    "docs:cli": "node tools/cli-docs.ts",
    "docs:cli:check": "node tools/cli-docs.ts --check",
    "fix": "vp lint --fix && vp fmt",
    "prepack": "npm run build:lib && npm run build:bin",
    "prepare": "patch-package && effect-tsgo patch --tsrs --oxlint",
    "setup": "npm run codegen",
    "test": "vp test run",
    "test:integration": "vp test run --project integration",
    "test:interop": "vp test run --project interop",
    "test:unit": "vp test run --project unit",
    "verify:ui": "npm run build:ui && node src/ui/verify.ts",
    "verify:worker": "node tools/verify-worker.ts",
    "watch:ui": "vp build --watch"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.87",
    "@distilled.cloud/cloudflare": "1.0.0-rc.20",
    "@effect/platform-node": "4.1.4",
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.4",
    "@foldkit/devtools": "0.171.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/ui": "0.171.0",
    "@foldkit/vite-plugin": "0.29.1",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@oxlint/plugins": "1.94.0",
    "@phosphor-icons/core": "2.1.1",
    "@pierre/diffs": "1.6.4",
    "@pierre/trees": "1.0.0",
    "@types/node": "26.6.6",
    "alchemy": "2.0.0-beta.87",
    "devalue": "6.0.3",
    "effect": "4.1.4",
    "foldkit": "0.171.0",
    "ignore": "7.0.16",
    "miniflare": "5.20261023.2-beta",
    "oxlint-tsgolint": "7.0.2007",
    "patch-package": "8.0.1",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "undici": "8.12.4",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0",
    "wrangler": "4.165.0"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  },
  "overrides": {
    "@effect/platform-browser": "4.1.4",
    "effect": "$effect",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "engines": {
    "git": "2.56.1",
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true,
    "sharp": true
  }
}
