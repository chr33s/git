{
  "name": "@chr33s/git",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Git smart-HTTP protocol server, browser client & nix cli",
  "license": "MIT",
  "bin": {
    "git+": "./src/cli/bin.ts",
    "git-remote-git+id": "./src/cli/remote-id.node.ts"
  },
  "files": [
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.integration.ts",
    "!src/**/*.contract.ts",
    "!src/**/*.build.ts"
  ],
  "type": "module",
  "scripts": {
    "build:sea": "npm run codegen && node src/cli/sea.build.ts",
    "build:ui": "vp build",
    "build:ui:debug": "vp build --mode development",
    "check": "vp fmt --check && vp lint",
    "codegen": "node tools/generate-version.ts && wrangler types -c wrangler.test.json",
    "dev:ui": "node src/ui/dev.ts",
    "watch:ui": "vp build --watch",
    "docs:cli": "node tools/generate-cli-reference.ts",
    "docs:cli:check": "node tools/generate-cli-reference.ts --check",
    "fix": "vp lint --fix && vp fmt",
    "prepare": "patch-package && effect-tsgo patch --oxlint",
    "setup": "npm run codegen",
    "test": "vp test run",
    "test:integration": "vp test run --project integration",
    "test:interop": "vp test run --project interop",
    "test:unit": "vp test run --project unit",
    "test:watch": "vp test --project unit",
    "verify:ui": "npm run build:ui && node src/ui/verify.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@chr33s/base-wc": "github:chr33s/base-wc",
    "@effect/platform-node": "4.0.0-rc.111",
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "4.0.0-rc.111",
    "@oxlint/plugins": "1.78.0",
    "@phosphor-icons/core": "2.1.1",
    "@pierre/diffs": "1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@types/node": "26.2.0",
    "alchemy": "2.0.0-beta.74",
    "lit": "3.3.3",
    "patch-package": "8.0.1",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  },
  "engines": {
    "git": "2.55.0",
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "fsevents": true,
    "workerd": true,
    "sharp": true
  }
}
