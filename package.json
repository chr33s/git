{
  "name": "@chr33s/git",
  "version": "0.2.0",
  "private": true,
  "description": "Universal Git smart-HTTP protocol server, browser client & nix cli",
  "license": "MIT",
  "bin": {
    "git+": "./src/cli/bin.ts",
    "git-remote-git+id": "./src/cli/remote-id.node.ts"
  },
  "files": [
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.integration.ts",
    "!src/**/*.contract.ts",
    "!src/**/*.build.ts"
  ],
  "type": "module",
  "scripts": {
    "build:sea": "npm run codegen && npm run build:ui && node src/cli/sea.build.ts",
    "build:ui": "vp build",
    "build:ui:debug": "vp build --mode development",
    "check": "vp fmt --check && vp lint && npm run docs:cli:check",
    "codegen": "node tools/generate-version.ts && wrangler types -c wrangler.test.json",
    "dev:ui": "node src/ui/dev.ts",
    "watch:ui": "vp build --watch",
    "docs:cli": "node tools/cli-docs.ts",
    "docs:cli:check": "node tools/cli-docs.ts --check",
    "fix": "vp lint --fix && vp fmt",
    "prepare": "patch-package && effect-tsgo patch --tsrs --oxlint",
    "setup": "npm run codegen",
    "test": "vp test run",
    "test:integration": "vp test run --project integration",
    "test:interop": "vp test run --project interop",
    "test:unit": "vp test run --project unit",
    "verify:ui": "npm run build:ui && node src/ui/verify.ts",
    "verify:worker": "node tools/verify-worker.ts"
  },
  "dependencies": {
    "effect": "4.1.4",
    "ignore": "7.0.16"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.87",
    "@distilled.cloud/cloudflare": "1.0.0-rc.20",
    "@effect/platform-node": "4.1.4",
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.4",
    "@foldkit/devtools": "0.171.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/ui": "0.171.0",
    "@foldkit/vite-plugin": "0.29.1",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@oxlint/plugins": "1.94.0",
    "@phosphor-icons/core": "2.1.1",
    "@pierre/diffs": "1.6.4",
    "@pierre/trees": "1.0.0",
    "@types/node": "26.6.6",
    "alchemy": "2.0.0-beta.87",
    "devalue": "6.0.3",
    "foldkit": "0.171.0",
    "miniflare": "5.20261023.2-beta",
    "oxlint-tsgolint": "7.0.2007",
    "patch-package": "8.0.1",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "undici": "8.12.4",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0",
    "wrangler": "4.165.0"
  },
  "overrides": {
    "@effect/platform-browser": "4.1.4",
    "effect": "$effect",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "engines": {
    "git": "2.56.0",
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true,
    "sharp": true
  }
}
