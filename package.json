{
  "name": "@chr33s/git",
  "version": "0.1.1",
  "private": true,
  "description": "Universal Git smart-HTTP protocol server, browser client & nix cli",
  "license": "MIT",
  "bin": {
    "git+": "./src/cli/bin.ts",
    "git-remote-git+id": "./src/cli/remote-id.node.ts"
  },
  "files": [
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.integration.ts",
    "!src/**/*.contract.ts",
    "!src/**/*.build.ts"
  ],
  "type": "module",
  "scripts": {
    "build:sea": "npm run codegen && node src/cli/sea.build.ts",
    "build:ui": "vp build",
    "build:ui:debug": "vp build --mode development",
    "check": "vp fmt --check && vp lint && npm run docs:cli:check",
    "codegen": "node tools/generate-version.ts && wrangler types -c wrangler.test.json",
    "dev:ui": "node src/ui/dev.ts",
    "watch:ui": "vp build --watch",
    "docs:cli": "node tools/cli-docs.ts",
    "docs:cli:check": "node tools/cli-docs.ts --check",
    "fix": "vp lint --fix && vp fmt",
    "prepare": "patch-package && effect-tsgo patch --oxlint",
    "setup": "npm run codegen",
    "test": "vp test run",
    "test:integration": "vp test run --project integration",
    "test:interop": "vp test run --project interop",
    "test:unit": "vp test run --project unit",
    "verify:ui": "npm run build:ui && node src/ui/verify.ts"
  },
  "dependencies": {
    "effect": "4.0.7",
    "ignore": "7.0.14"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@chr33s/base-wc": "github:chr33s/base-wc",
    "@effect/platform-node": "4.0.7",
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.0.7",
    "@foldkit/devtools": "0.169.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@foldkit/vite-plugin": "0.28.0",
    "@oxlint/plugins": "1.90.0",
    "@phosphor-icons/core": "2.1.1",
    "@pierre/diffs": "1.6.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@types/node": "26.6.6",
    "alchemy": "2.0.0-beta.84",
    "foldkit": "0.169.0",
    "patch-package": "8.0.1",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  },
  "overrides": {
    "@effect/platform-browser": "4.0.7",
    "effect": "$effect",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "git": "2.56.0",
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true,
    "sharp": true
  }
}
