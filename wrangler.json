{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "git",
  "main": "src/git/Durable.ts",
  "compatibility_date": "2025-12-10",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8080
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GitRepo",
        "name": "GIT_REPO"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "GIT_OBJECTS",
      "bucket_name": "git-objects"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GitRepo"]
    }
  ]
}
