# Shared standalone-node and `git+ serve` configuration.
# Explicit `git+ serve --root/--port/--hostname` flags take precedence.
GIT_ROOT=./repos
PORT=8080
HOSTNAME=127.0.0.1

# Aggregate protocol budgets (positive integers; byte limits apply after gzip).
# GIT_NEGOTIATION_BYTES=2097152
# GIT_NEGOTIATION_LINES=20000
# Shared graph-planning work per completed upload-pack request.
# GIT_FETCH_GRAPH_STEPS=250000
# GIT_RECEIVE_BYTES=536870912
# GIT_RECEIVE_COMMANDS=10000
# GIT_RECEIVE_COMMAND_BYTES=2097152
# GIT_RECEIVE_OBJECTS=100000
# GIT_RECEIVE_EXPANDED_BYTES=536870912
# GIT_LFS_BATCH_BYTES=1048576
# GIT_LFS_BATCH_OBJECTS=1000
# GIT_LFS_UPLOAD_BYTES=1073741824
# GIT_JSON_BODY_BYTES=8388608

# Node HTTP admission and deadlines (positive integers; times in milliseconds).
# GIT_HTTP_MAX_ACTIVE=32
# GIT_HTTP_MAX_PER_REPO=8
# GIT_HTTP_MAX_CONNECTIONS=128
# GIT_HTTP_DEADLINE_MS=300000
# GIT_HTTP_IDLE_MS=30000
# GIT_HTTP_HEADERS_MS=15000
# Cumulative request metrics to stderr; 0 disables periodic export.
# GIT_HTTP_METRICS_INTERVAL_MS=60000
# Optional operations HTTP listener on 127.0.0.1 only; unset disables it.
# GIT_OPERATIONS_PORT=9091

# Node server outbound policy. Private origins are exact origins, not URL paths.
# GIT_EGRESS_PRIVATE_ORIGINS=https://mirror.internal,http://127.0.0.1:9000
# Development only: allow localhost / loopback destinations on any port.
# GIT_EGRESS_ALLOW_LOOPBACK=false

# Cloudflare per-Durable-Object admission, including queued work and response delivery.
# GIT_CF_MAX_ACTIVE=8
# Per-Worker-isolate admission, including public snapshot reads and forwarded requests.
# GIT_CF_EDGE_MAX_ACTIVE=32
# Time until a handler produces a response; cancellation waits for writes to settle.
# GIT_CF_REQUEST_DEADLINE_MS=300000
# GIT_CF_UPLOAD_IDLE_MS=30000
# Native per-location limiter: choose a distinct positive namespace per deployment.
# An unset/empty namespace disables this binding; production ingress still needs rate limits.
# GIT_CF_RATE_NAMESPACE=1001
# GIT_CF_RATE_PER_MINUTE=600
# Retained LFS payload bytes/objects per repository (Node and R2 backends).
# GIT_LFS_RETAINED_BYTES=10737418240
# GIT_LFS_RETAINED_OBJECTS=100000
# Retained Git R2 payload bytes/keys per repository, including orphan packs.
# Requires a single SQLite owner and offline reconciliation after older writers.
# GIT_CF_RETAINED_BYTES=10737418240
# GIT_CF_RETAINED_KEYS=100000
# Retained SQLite ref/reflog/shallow text bytes and rows per repository.
# GIT_CF_REF_METADATA_BYTES=8388608
# GIT_CF_REF_METADATA_ROWS=100000
# Per-repository limits for each SQL remote/webhook registry (includes secrets).
# GIT_CF_REGISTRY_BYTES=1048576
# GIT_CF_REGISTRY_ROWS=128
# Node remote/webhook JSON registry limits (serialized bytes, including whitespace).
# GIT_REGISTRY_BYTES=1048576
# GIT_REGISTRY_ROWS=128
# Node Artifacts provider: independent namespace-wide JSON metadata budgets.
# GIT_ARTIFACTS_REGISTRY_BYTES=1048576
# GIT_ARTIFACTS_REGISTRY_ROWS=1024
# GIT_ARTIFACTS_TOKEN_BYTES=2097152
# GIT_ARTIFACTS_TOKEN_ROWS=4096
# Fork-link JSON and each borrower/alternate metadata file.
# GIT_ARTIFACTS_FORK_BYTES=1048576
# GIT_ARTIFACTS_FORK_ROWS=1024
# Per-repository HEAD UTF-8 target budget (1..65536).
# GIT_CF_HEAD_BYTES=1024
# Per-object Cloudflare snapshot/journal byte limit (1..67108864).
# GIT_CF_SNAPSHOT_BYTES=16777216
# SQLite Artifacts namespace limits (logical UTF-8 column bytes, excludes indexes).
# GIT_CF_ARTIFACTS_REGISTRY_BYTES=1048576
# GIT_CF_ARTIFACTS_REGISTRY_ROWS=1024
# GIT_CF_ARTIFACTS_TOKEN_BYTES=2097152
# GIT_CF_ARTIFACTS_TOKEN_ROWS=4096
# Linux startup assertion: storage must already be on a separate filesystem
# whose total capacity is at most this many bytes. Does not create a quota.
# GIT_STORAGE_FILESYSTEM_BYTES=107374182400
# Response delivery only: source/reader idle and absolute deadlines in milliseconds.
# GIT_CF_RESPONSE_IDLE_MS=30000
# GIT_CF_RESPONSE_DEADLINE_MS=300000
# Local Alchemy Worker only; strict mode refuses a taken port instead of moving.
# GIT_DEV_PORT=1337
# GIT_DEV_STRICT_PORT=false
# Cloudflare outbound integrations are denied unless the operator trusts
# the exact HTTPS origin AND its DNS/routing. This is not DNS rebinding protection.
# GIT_EGRESS_TRUSTED_ORIGINS=https://mirror.example.com,https://hooks.example.com
